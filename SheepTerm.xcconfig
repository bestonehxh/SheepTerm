// Build settings for the SheepTerm target (5.0 (7)).
//
// The Google OAuth client secret for Sync (Settings → Sync) is NOT kept in
// the repository: it lives in Secrets.xcconfig next to this file, which is
// gitignored and never exported to the public repo. Without that file the
// value stays empty, `SheepTermSync` treats Sync as not configured (no
// sidebar account button, "Not available in this build" in Settings) — a
// public clone still builds. Secrets.xcconfig holds one line:
//
//     SHEEPSYNC_GOOGLE_CLIENT_SECRET = GOCSPX-…
//
// (Google treats a Desktop-app secret as not confidential — it ships inside
// the app — PKCE is what protects the sign-in. It is kept out of git only so
// it is not trivially reusable from the source.)
SHEEPSYNC_GOOGLE_CLIENT_SECRET =
#include? "Secrets.xcconfig"

// Code signing (5.0 (10)). Every release is signed with ONE stable identity
// so macOS recognises each update as the same app: an ad-hoc signature is
// recognised only by its hash, which changes with every build, and the
// Keychain then asked again for every saved password after every update.
// The identity ("Sheep Apps Signing", a self-signed code-signing certificate
// in the login keychain, shared by the Sheep apps) is named in the gitignored
// Signing.xcconfig; without that file — a public clone — the build is
// ad-hoc-signed as before. release.sh refuses to ship anything else
// (CODESIGN_AUTHORITY in .ship.conf).
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
#include? "Signing.xcconfig"
