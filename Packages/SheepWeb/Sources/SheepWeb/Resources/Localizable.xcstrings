{
  "sourceLanguage": "en",
  "strings": {
    "%@ can’t provide a secure connection: it sent a response that can’t be accepted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann keine sichere Verbindung bereitstellen: Es hat eine nicht akzeptable Antwort gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede proporcionar una conexión segura: ha enviado una respuesta que no se puede aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas fournir de connexion sécurisée : il a envoyé une réponse inacceptable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は安全な接続を提供できません: 受け入れられない応答が送信されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 보안 연결을 제공할 수 없습니다: 허용할 수 없는 응답을 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode fornecer uma conexão segura: enviou uma resposta que não pode ser aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может обеспечить безопасное соединение: он отправил недопустимый ответ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法提供安全连接：它发送了无法接受的响应。"
          }
        }
      }
    },
    "%@ didn’t accept your login certificate, or one wasn’t provided.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Ihr Anmeldezertifikat nicht akzeptiert oder es wurde keines angegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha aceptado tu certificado de inicio de sesión o no se ha proporcionado ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas accepté votre certificat de connexion, ou aucun n’a été fourni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はログイン証明書を受け入れなかったか、証明書が提供されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 로그인 인증서를 수락하지 않았거나 인증서가 제공되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceitou seu certificado de login ou nenhum foi fornecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не принял ваш сертификат для входа, либо он не был предоставлен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未接受您的登录证书，或未提供证书。"
          }
        }
      }
    },
    "%@ didn’t send any data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine Daten gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha enviado ningún dato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a envoyé aucune donnée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はデータを送信しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 데이터를 보내지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não enviou nenhum dado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не отправил никаких данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有发送任何数据。"
          }
        }
      }
    },
    "%@ is blocked by the content blocker.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird vom Inhaltsblocker blockiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueador de contenido bloquea %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est bloqué par le bloqueur de contenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はコンテンツブロッカによってブロックされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 콘텐츠 차단기에 의해 차단되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está bloqueado pelo bloqueador de conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ заблокирован блокировщиком контента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被内容拦截器拦截。"
          }
        }
      }
    },
    "%@ needs a user name and password, and none was accepted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erfordert einen Benutzernamen und ein Passwort, und keine Eingabe wurde akzeptiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requiere un nombre de usuario y una contraseña, y no se ha aceptado ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite un nom d’utilisateur et un mot de passe, et aucun n’a été accepté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはユーザ名とパスワードが必要ですが、受け入れられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 사용자 이름과 암호가 필요하지만 수락된 것이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exige um nome de usuário e uma senha, e nenhum foi aceito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ требует имя пользователя и пароль, но ни один вариант не был принят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要用户名和密码，但均未被接受。"
          }
        }
      }
    },
    "%@ redirected to an address that doesn’t exist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat auf eine nicht vorhandene Adresse weitergeleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha redirigido a una dirección que no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a redirigé vers une adresse qui n’existe pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は存在しないアドレスにリダイレクトしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 존재하지 않는 주소로 리디렉션되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redirecionou para um endereço que não existe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ перенаправил на несуществующий адрес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 重定向到了不存在的地址。"
          }
        }
      }
    },
    "%@ redirected you too many times.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Sie zu oft weitergeleitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te ha redirigido demasiadas veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous a redirigé trop de fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からのリダイレクトが多すぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 너무 많이 리디렉션되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redirecionou você muitas vezes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ слишком много раз перенаправлял вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将您重定向的次数过多。"
          }
        }
      }
    },
    "%@ refused to connect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Verbindung abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rechazado la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は接続を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 연결을 거부했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recusou a conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отказал в соединении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了连接。"
          }
        }
      }
    },
    "%@ sent an invalid response.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine ungültige Antwort gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha enviado una respuesta no válida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a envoyé une réponse non valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が無効な応答を送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 잘못된 응답을 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enviou uma resposta inválida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отправил недопустимый ответ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 发送了无效的响应。"
          }
        }
      }
    },
    "%@ sent data that can’t be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Daten gesendet, die nicht gelesen werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha enviado datos que no se pueden leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a envoyé des données illisibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が読み取れないデータを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 읽을 수 없는 데이터를 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enviou dados que não podem ser lidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отправил данные, которые невозможно прочитать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 发送了无法读取的数据。"
          }
        }
      }
    },
    "%@ took too long to respond.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange für die Antwort gebraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tardado demasiado en responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis trop de temps à répondre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からの応答に時間がかかりすぎました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 응답 시간이 너무 오래 걸렸습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demorou muito para responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ слишком долго не отвечает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 响应时间过长。"
          }
        }
      }
    },
    "%@’s server IP address could not be found (DNS).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server-IP-Adresse von %@ wurde nicht gefunden (DNS)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado la dirección IP del servidor de %@ (DNS)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse IP du serveur de %@ est introuvable (DNS)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のサーバのIPアドレスが見つかりませんでした(DNS)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 서버 IP 주소를 찾을 수 없습니다(DNS)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar o endereço IP do servidor de %@ (DNS)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти IP-адрес сервера %@ (DNS)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@ 的服务器 IP 地址（DNS）。"
          }
        }
      }
    },
    "A problem repeatedly occurred on “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf „%@“ ist wiederholt ein Problem aufgetreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha producido un problema repetidamente en “%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème s’est produit à plusieurs reprises sur « %@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」で問題が繰り返し発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에서 문제가 반복적으로 발생했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um problema repetidamente em “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На странице «%@» неоднократно возникала проблема."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”反复出现问题。"
          }
        }
      }
    },
    "Access to %@ is restricted on this Mac (Screen Time or a content filter).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf %@ ist auf diesem Mac eingeschränkt (Bildschirmzeit oder ein Inhaltsfilter)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a %@ está restringido en este Mac (Tiempo de uso o un filtro de contenido)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à %@ est restreint sur ce Mac (Temps d’écran ou un filtre de contenu)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは%@へのアクセスが制限されています(スクリーンタイムまたはコンテンツフィルタ)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 %@에 대한 접근이 제한되어 있습니다(스크린 타임 또는 콘텐츠 필터)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso a %@ está restrito neste Mac (Tempo de Uso ou um filtro de conteúdo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к %@ ограничен на этом Mac (Экранное время или фильтр контента)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上对 %@ 的访问受到限制（“屏幕使用时间”或内容过滤器）。"
          }
        }
      }
    },
    "Can’t Connect to the Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Server nicht möglich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter au serveur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバに接続できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
