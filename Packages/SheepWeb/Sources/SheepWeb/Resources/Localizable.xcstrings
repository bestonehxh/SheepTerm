    "Your connection to %@ isn’t private: its certificate has expired or isn’t valid yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Verbindung zu %@ ist nicht privat: Das Zertifikat ist abgelaufen oder noch nicht gültig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conexión con %@ no es privada: su certificado ha caducado o aún no es válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre connexion à %@ n’est pas privée : son certificat a expiré ou n’est pas encore valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@への接続はプライベートではありません: 証明書の有効期限が切れているか、まだ有効ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 연결이 비공개가 아닙니다: 인증서가 만료되었거나 아직 유효하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conexão com %@ não é privada: o certificado expirou ou ainda não é válido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше соединение с %@ не защищено: срок действия сертификата истёк или он ещё не действителен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您与 %@ 的连接不是私密连接：其证书已过期或尚未生效。"
          }
        }
      }
    },
    "Your connection to %@ isn’t private: its certificate isn’t trusted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Verbindung zu %@ ist nicht privat: Dem Zertifikat wird nicht vertraut."
