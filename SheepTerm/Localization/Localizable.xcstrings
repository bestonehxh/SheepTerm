    "Replace uses the file's version — your saved password reference is kept. Keep leaves your version untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ersetzen“ verwendet die Version der Datei – Ihr gespeicherter Passwortverweis bleibt erhalten. „Behalten“ lässt Ihre Version unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar usa la versión del archivo; se conserva tu referencia a la contraseña guardada. Conservar deja tu versión intacta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacer utilise la version du fichier — votre référence au mot de passe enregistré est conservée. Garder laisse votre version intacte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「置き換える」はファイルの内容を使用します — 保存済みのパスワード参照は保持されます。「保持」はこちらの内容をそのまま残します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교체하면 파일의 버전을 사용합니다 — 저장된 암호 참조는 유지됩니다. 유지하면 내 버전이 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substituir usa a versão do arquivo — a sua referência de senha salva é mantida. Manter deixa a sua versão intacta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Заменить» использует версию из файла — ссылка на сохраненный пароль сохраняется. «Оставить» не трогает Вашу версию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“替换”使用文件中的版本，但保留您已保存的密码关联。“保留”则不更改您的版本。"
          }
        }
      }
