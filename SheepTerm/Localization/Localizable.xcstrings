    "Comes from “%@” — a credential's username and its password are one login. Pick “None (enter manually)” to type a different name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stammt von „%@“ – Benutzername und Passwort von Anmeldedaten bilden ein Login. Wählen Sie „Ohne (manuell eingeben)“, um einen anderen Namen einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proviene de “%@”: el nombre de usuario de una credencial y su contraseña forman un único inicio de sesión. Elige “Ninguna (escribir manualmente)” para escribir otro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provient de « %@ » — le nom d’utilisateur d’un identifiant et son mot de passe forment un seul compte. Choisissez « Aucun (saisie manuelle) » pour saisir un autre nom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」から取得しています — 認証情報のユーザ名とパスワードは 1 つのログイン情報です。別の名前を入力するには「なし（手動で入力）」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에서 가져옴 — 자격 증명의 사용자 이름과 암호는 하나의 로그인입니다. 다른 이름을 입력하려면 “없음(직접 입력)”을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vem de “%@” — o nome de usuário de uma credencial e a sua senha formam um único login. Escolha “Nenhuma (inserir manualmente)” para digitar outro nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берется из «%@» — имя пользователя и пароль учетных данных составляют один логин. Выберите «Нет (ввести вручную)», чтобы ввести другое имя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自“%@”——凭据的用户名和密码属于同一个登录。选择“无（手动输入）”可输入其他名称。"
          }
        }
      }
    },
