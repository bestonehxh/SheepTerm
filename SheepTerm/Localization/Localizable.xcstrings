    "After this the link stops working and the file is deleted from your Google Drive. Hosts already imported stay with the recipients." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After this the link stops working and the file is deleted from your Google Drive. Hosts already imported stay with the recipients."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此后链接将失效，文件也会从您的 Google 云端硬盘中删除。已导入的主机仍会保留在接收者那里。"
          }
        }
      }
