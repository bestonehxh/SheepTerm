    "The session ended or the tab was switched away after %lld of %lld lines, so the rest was not sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sitzung wurde nach %lld von %lld Zeilen beendet oder der Tab wurde gewechselt, daher wurde der Rest nicht gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión finalizó o se cambió de pestaña tras %lld de %lld líneas, así que el resto no se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session s’est terminée ou l’onglet a été quitté après %lld lignes sur %lld ; le reste n’a donc pas été envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld / %lld 行の時点でセッションが終了したかタブが切り替えられたため、残りは送信されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld/%lld줄을 보낸 후 세션이 종료되었거나 다른 탭으로 전환되어 나머지는 보내지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão terminou ou a aba foi trocada após %lld de %lld linhas, então o restante não foi enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессия завершилась или вкладка была переключена после %lld из %lld строк, поэтому остальное не отправлено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话在发送 %1$lld/%2$lld 行后结束或标签页已切换，其余内容未发送。"
          }
        }
      }
    },
    "The session stopped accepting input after %lld of %lld lines, so the rest was not sent." : {
      "localizations" : {
