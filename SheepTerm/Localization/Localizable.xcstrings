    "Commands you send often. The Snippets menu types one into the current tab; a multi-line snippet goes through Safe Paste like any paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häufig gesendete Befehle. Das Menü „Snippets“ tippt einen in den aktuellen Tab; ein mehrzeiliges Snippet durchläuft wie jedes Einsetzen das sichere Einsetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commands you send often. The Snippets menu types one into the current tab; a multi-line snippet goes through Safe Paste like any paste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos que envías a menudo. El menú Fragmentos escribe uno en la pestaña actual; un fragmento de varias líneas pasa por Pegado seguro como cualquier otro pegado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les commandes que vous envoyez souvent. Le menu Extraits en saisit une dans l’onglet actuel ; un extrait sur plusieurs lignes passe par le collage sécurisé comme tout collage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく送信するコマンドです。スニペットメニューから現在のタブに入力できます。複数行のスニペットは、ほかのペーストと同様に安全なペーストを経由します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 보내는 명령입니다. 스니펫 메뉴는 현재 탭에 하나를 입력합니다. 여러 줄 스니펫은 다른 붙여넣기와 마찬가지로 안전한 붙여넣기를 거칩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos que você envia com frequência. O menu Snippets digita um deles na aba atual; um snippet de várias linhas passa pela Colagem Segura como qualquer colagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часто отправляемые команды. Меню «Сниппеты» вводит выбранный в текущую вкладку; многострочный сниппет проходит через безопасную вставку, как любая вставка."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您经常发送的命令。“代码片段”菜单会将其中一条输入到当前标签页；多行片段会像普通粘贴一样经过安全粘贴。"
          }
        }
      }
    },
