    "Forgets the Google sign-in and the vault key on this Mac. Your hosts and passwords stay here, and the synced copy stays for your other Macs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergisst die Google-Anmeldung und den Tresorschlüssel auf diesem Mac. Ihre Hosts und Passwörter bleiben hier, und die synchronisierte Kopie bleibt für Ihre anderen Macs erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgets the Google sign-in and the vault key on this Mac. Your hosts and passwords stay here, and the synced copy stays for your other Macs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvida el inicio de sesión de Google y la clave de la bóveda en este Mac. Tus hosts y contraseñas permanecen aquí, y la copia sincronizada se conserva para tus otros Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublie la connexion Google et la clé du coffre sur ce Mac. Vos hôtes et mots de passe restent ici, et la copie synchronisée reste disponible pour vos autres Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacの Google サインインと保管庫の鍵を消去します。ホストとパスワードはこのMacに残り、同期されたコピーはほかのMac用に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Google 로그인과 보관함 키를 지웁니다. 호스트와 암호는 이곳에 남으며, 동기화된 사본은 다른 Mac을 위해 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquece o início de sessão do Google e a chave do cofre neste Mac. Os seus hosts e senhas ficam aqui, e a cópia sincronizada fica disponível para os seus outros Macs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет вход Google и ключ хранилища на этом Mac. Хосты и пароли остаются здесь, а синхронизированная копия остается для других Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘记此 Mac 上的 Google 登录和保管库密钥。您的主机和密码会保留在这里，同步副本也会为您的其他 Mac 保留。"
          }
        }
      }
    },
