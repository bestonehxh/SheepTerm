    "No %@ yet — a host key you trust is saved there on first connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine %@ – ein Hostschlüssel, dem Sie vertrauen, wird dort bei der ersten Verbindung gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay %@; la clave de host en la que confíes se guarda allí en la primera conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore de %@ — une clé d’hôte que vous approuvez y est enregistrée à la première connexion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はまだありません — 信頼したホスト鍵は最初の接続時にそこに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 %@ 없음 — 신뢰하는 호스트 키는 처음 연결할 때 여기에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há %@ — uma chave de host em que você confia é salva ali na primeira conexão."
          }
        },
        "ru" : {
