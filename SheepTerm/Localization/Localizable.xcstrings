          }
        }
      }
    },
    "The passphrase chosen when sync was turned on on your first Mac. This Mac's current hosts are set aside (like a restore) before the synced ones replace them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passphrase, die beim Aktivieren von Sync auf Ihrem ersten Mac gewählt wurde. Die aktuellen Hosts dieses Mac werden beiseitegelegt (wie bei einer Wiederherstellung), bevor die synchronisierten sie ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The passphrase chosen when sync was turned on on your first Mac. This Mac's current hosts are set aside (like a restore) before the synced ones replace them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frase de contraseña elegida al activar la sincronización en tu primer Mac. Los hosts actuales de este Mac se apartan (como en una restauración) antes de que los sincronizados los reemplacen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La phrase secrète choisie lors de l’activation de la synchronisation sur votre premier Mac. Les hôtes actuels de ce Mac sont mis de côté (comme lors d’une restauration) avant d’être remplacés par ceux synchronisés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のMacで同期をオンにしたときに選択したパスフレーズです。同期されたデータで置き換える前に、このMacの現在のホストは退避されます（復元と同様）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 번째 Mac에서 동기화를 켤 때 선택한 암호 문구입니다. 동기화된 호스트로 대체되기 전에 이 Mac의 현재 호스트는 옆으로 옮겨 둡니다(복원과 같음)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frase secreta escolhida quando a sincronização foi ativada no seu primeiro Mac. Os hosts atuais deste Mac são colocados de lado (como em uma restauração) antes que os sincronizados os substituam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Парольная фраза, заданная при включении синхронизации на первом Mac. Текущие хосты этого Mac откладываются в сторону (как при восстановлении), прежде чем их заменят синхронизированные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的第一台 Mac 上开启同步时选择的密码短语。在同步的主机替换它们之前，此 Mac 当前的主机会被放到一旁（类似于恢复）。"
          }
        }
      }
    },
    "The sender gives you this separately from the link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Absender teilt Ihnen diese getrennt vom Link mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sender gives you this separately from the link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El remitente te la da por separado del enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’expéditeur vous la communique séparément du lien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信者からリンクとは別に伝えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보낸 사람이 링크와 별도로 전달합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O remetente informa isto separadamente do link."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправитель передает ее Вам отдельно от ссылки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送者会通过链接以外的方式单独提供此信息。"
          }
        }
      }
    },
    "This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível desfazer esta ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。"
          }
        }
      }
    },
    "This host never writes a session log, even with Log Sessions to File on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Host schreibt nie ein Sitzungsprotokoll, auch wenn „Sitzungen in Datei protokollieren“ aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This host never writes a session log, even with Log Sessions to File on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host nunca escribe un registro de sesión, aunque Registrar sesiones en archivo esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet hôte n’écrit jamais de journal de session, même avec Journaliser les sessions dans un fichier activé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストは、「セッションをファイルに記録」がオンでもセッションログを書き込みません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트는 세션 로그를 파일로 기록이 켜져 있어도 세션 로그를 기록하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host nunca grava um registro de sessão, mesmo com Registrar Sessões em Arquivo ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот хост никогда не записывает журнал сессии, даже при включенном «Записывать сессии в файл»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
