    "This session never writes a log file, even with Log Sessions to File on. Saved with the host if you save it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung schreibt nie eine Protokolldatei, auch wenn „Sitzungen in Datei protokollieren“ aktiviert ist. Wird mit dem Host gesichert, wenn Sie ihn sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session never writes a log file, even with Log Sessions to File on. Saved with the host if you save it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión nunca escribe un archivo de registro, aunque Registrar sesiones en archivo esté activado. Se guarda con el host si lo guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session n’écrit jamais de fichier journal, même avec Journaliser les sessions dans un fichier activé. Enregistré avec l’hôte si vous l’enregistrez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションは、「セッションをファイルに記録」がオンでもログファイルを書き込みません。ホストを保存すると、この設定も一緒に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션은 세션 로그를 파일로 기록이 켜져 있어도 로그 파일을 기록하지 않습니다. 호스트를 저장하면 함께 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão nunca grava um arquivo de registro, mesmo com Registrar Sessões em Arquivo ativado. É salvo com o host se você salvá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сессия никогда не записывает файл журнала, даже при включенном «Записывать сессии в файл». Сохраняется вместе с хостом, если Вы его сохраните."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话永远不会写入日志文件，即使已开启“将会话日志保存到文件”。如果保存主机，此设置会随主机一起保存。"
          }
        }
      }
    },
