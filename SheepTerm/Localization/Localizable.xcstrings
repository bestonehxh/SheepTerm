    "Your previous configuration is in %@ inside SheepTerm's Application Support folder. To go back to it, use Restore and choose %@ from that folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre vorherige Konfiguration befindet sich in %@ im Ordner „Application Support“ von SheepTerm. Um zu ihr zurückzukehren, verwenden Sie „Wiederherstellen“ und wählen Sie %@ aus diesem Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu configuración anterior está en %@, dentro de la carpeta Application Support de SheepTerm. Para volver a ella, usa Restaurar y elige %@ en esa carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre configuration précédente se trouve dans %@, dans le dossier Application Support de SheepTerm. Pour y revenir, utilisez Restaurer et choisissez %@ dans ce dossier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の構成は SheepTerm の Application Support フォルダ内の %@ にあります。元に戻すには、「復元」を使用してそのフォルダから %@ を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 구성은 SheepTerm의 Application Support 폴더 안의 %@에 있습니다. 되돌리려면 복원을 사용하여 해당 폴더에서 %@을(를) 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua configuração anterior está em %@ dentro da pasta Application Support do SheepTerm. Para voltar a ela, use Restaurar e escolha %@ nessa pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущая конфигурация находится в %@ в папке Application Support SheepTerm. Чтобы вернуться к ней, выберите «Восстановить» и укажите %@ в этой папке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您之前的配置位于 SheepTerm 的 Application Support 文件夹中的 %1$@。要恢复到该配置，请使用“恢复”并从该文件夹中选择 %2$@。"
          }
        }
      }
    },
    "Your previous configuration is in %@ inside SheepTerm's Application Support folder; restore it from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
