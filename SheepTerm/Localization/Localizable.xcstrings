    "Let a device send a file here (a config backup) — into the folder, never over an existing file" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gerät darf eine Datei hierher senden (Konfigurationssicherung) – in den Ordner, nie über eine bestehende Datei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que un equipo envíe un archivo aquí (copia de la configuración): a la carpeta, nunca sobre un archivo existente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser un équipement à envoyer un fichier ici (sauvegarde de configuration) : dans le dossier, jamais par-dessus un fichier existant"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機器からのファイル受信を許可（設定のバックアップ）— フォルダへ保存し、既存ファイルは上書きしません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장비가 파일(구성 백업)을 보내도록 허용 — 폴더에 저장하며 기존 파일은 덮어쓰지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um equipamento envie um arquivo para cá (backup da configuração): na pasta, nunca sobre um arquivo existente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить устройству отправлять сюда файл (резервную копию конфигурации) — в папку, никогда поверх существующего файла"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许设备向此处发送文件（配置备份）——存入文件夹，绝不覆盖已有文件"
          }
        }
      }
    },
