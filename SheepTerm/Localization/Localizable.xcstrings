        }
      }
    },
    "You're up to date" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已是最新版本"
          }
        }
      }
    },
    "Your previous configuration is in %@ inside SheepTerm's Application Support folder. To go back to it, use Restore and choose %@ from that folder." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您之前的配置位于 SheepTerm 的 Application Support 文件夹中的 %1$@。要恢复到该配置，请使用“恢复”并从该文件夹中选择 %2$@。"
          }
        }
      }
    },
    "Your previous configuration is in %@ inside SheepTerm's Application Support folder; restore it from there." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
