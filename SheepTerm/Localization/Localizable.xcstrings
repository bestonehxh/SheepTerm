    "The certificate has CHANGED since you trusted it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat hat sich GEÄNDERT, seit Sie ihm vertraut haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The certificate has CHANGED since you trusted it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado ha CAMBIADO desde que confiaste en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat a CHANGÉ depuis que vous l’avez approuvé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼した時点から証明書が変更されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰한 이후 인증서가 변경되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado MUDOU desde que você confiou nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат ИЗМЕНИЛСЯ с момента, когда Вы ему доверились."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此证书与您此前信任的证书不同。"
          }
        }
      }
    },
    "The connection was refused — this can mean a man-in-the-middle. " : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung wurde abgelehnt – dies kann auf einen Man-in-the-Middle-Angriff hindeuten. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was refused — this can mean a man-in-the-middle. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó la conexión: esto puede indicar un ataque de intermediario (man-in-the-middle). "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été refusée — cela peut indiquer une attaque de l’homme du milieu. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続は拒否されました — 中間者攻撃の可能性があります。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 거부되었습니다 — 중간자 공격을 의미할 수 있습니다. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão foi recusada — isso pode indicar um ataque man-in-the-middle. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение отклонено — это может означать атаку «человек посередине». "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接被拒绝——这可能意味着中间人攻击。"
          }
        }
      }
    },
