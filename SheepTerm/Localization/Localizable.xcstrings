          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치됨 — 로그아웃됨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado — sessão encerrada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установлено — вход не выполнен"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
