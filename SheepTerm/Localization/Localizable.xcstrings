    },
    "Only if this host is an HA pair or you know its key was replaced. Both keys will be trusted for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn dieser Host ein HA-Paar ist oder Sie wissen, dass sein Schlüssel ersetzt wurde. Beiden Schlüsseln wird für %@ vertraut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si este host es un par HA o sabes que su clave se reemplazó. Se confiará en ambas claves para %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement si cet hôte est une paire HA ou si vous savez que sa clé a été remplacée. Les deux clés seront approuvées pour %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストが HA ペアである場合、または鍵が交換されたことが分かっている場合のみ。%@ では両方の鍵が信頼されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트가 HA 쌍이거나 키가 교체되었음을 아는 경우에만 사용하십시오. %@에 대해 두 키 모두 신뢰합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente se este host for um par HA ou se você souber que a chave foi substituída. Ambas as chaves serão confiáveis para %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только если этот хост — пара HA или Вы знаете, что его ключ заменен. Оба ключа будут доверенными для %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当此主机为 HA 双机或您确认其密钥已更换时才继续。%@ 的两个密钥都将被信任。"
          }
        }
      }
    },
    "Only if you know the device was reinstalled or its key replaced, remove the old key in Known Hosts and connect again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn Sie wissen, dass das Gerät neu installiert oder sein Schlüssel ersetzt wurde: Entfernen Sie den alten Schlüssel unter „Bekannte Hosts“ und verbinden Sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si sabes que el dispositivo se reinstaló o que su clave se reemplazó, elimina la clave antigua en Hosts conocidos y vuelve a conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement si vous savez que l’appareil a été réinstallé ou que sa clé a été remplacée : supprimez l’ancienne clé dans Hôtes connus et reconnectez-vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスが再インストールされたか鍵が交換されたことが分かっている場合のみ、既知のホストで古い鍵を削除してから再接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장비가 재설치되었거나 키가 교체되었음을 아는 경우에만 알려진 호스트에서 이전 키를 제거하고 다시 연결하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente se você souber que o dispositivo foi reinstalado ou que a chave foi substituída, remova a chave antiga em Hosts Conhecidos e conecte novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только если Вы знаете, что устройство переустановлено или его ключ заменен, удалите старый ключ в «Известных хостах» и подключитесь снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
