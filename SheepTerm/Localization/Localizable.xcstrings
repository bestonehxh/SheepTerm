    "%@ and %lld more. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ und %lld weitere. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ y %lld más. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ et %lld de plus. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ほか %lld 件。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 외 %lld개. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e mais %lld. Não é possível desfazer esta ação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и еще %lld. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 及另外 %2$lld 项。此操作无法撤销。"
          }
        }
      }
    },
    "%@ could not be read (%@). Command history starts empty and the file will not be overwritten until you clear history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht gelesen werden (%@). Der Befehlsverlauf beginnt leer und die Datei wird erst überschrieben, wenn Sie den Verlauf löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer %@ (%@). El historial de comandos empieza vacío y el archivo no se sobrescribirá hasta que borres el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire %@ (%@). L’historique des commandes est vide et le fichier ne sera pas écrasé tant que vous n’effacez pas l’historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を読み込めませんでした（%@）。コマンド履歴は空の状態で始まり、履歴を消去するまでファイルは上書きされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 읽을 수 없습니다(%@). 명령 기록은 비어 있는 상태로 시작하며 기록을 지울 때까지 파일을 덮어쓰지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler %@ (%@). O histórico de comandos começa vazio e o arquivo não será substituído até que você limpe o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать %@ (%@). История команд пуста, и файл не будет перезаписан, пока Вы не очистите историю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@）。命令历史记录将以空白开始，在您清除历史记录之前不会覆盖该文件。"
          }
        }
      }
    },
