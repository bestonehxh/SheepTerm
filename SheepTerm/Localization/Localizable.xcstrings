    "Fill Login (the key in the tab's bar) types this login into the page — only on this host's own address, never submitted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Login ausfüllen“ (der Schlüssel in der Leiste des Tabs) tippt dieses Login in die Seite – nur auf der eigenen Adresse dieses Hosts, wird nie abgesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill Login (the key in the tab's bar) types this login into the page — only on this host's own address, never submitted"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellenar inicio de sesión (la llave en la barra de la pestaña) escribe este inicio de sesión en la página, solo en la dirección propia de este host y sin enviarlo nunca"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplir l’identification (la clé dans la barre de l’onglet) saisit cet identifiant dans la page — uniquement à l’adresse propre de cet hôte, jamais envoyé"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン情報を入力（タブのバーにある鍵）で、このログイン情報をページに入力します — このホスト自身のアドレスでのみ行い、送信はしません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 채우기(탭 막대의 키)는 이 로그인을 페이지에 입력합니다 — 이 호스트 자체의 주소에서만 작동하며 제출하지는 않습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencher Login (a chave na barra da aba) digita este login na página — somente no próprio endereço deste host, nunca enviado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Заполнить логин» (ключ на панели вкладки) вводит этот логин на странице — только по собственному адресу этого хоста, без отправки формы"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“填充登录”（标签页栏中的钥匙）会将此登录信息输入到页面中——仅限此主机自己的地址，绝不会提交"
          }
        }
      }
