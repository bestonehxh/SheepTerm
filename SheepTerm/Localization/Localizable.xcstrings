    "Cryptography comes from macOS itself (CryptoKit, CommonCrypto, Security) and is updated with the system." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kryptografie stammt von macOS selbst (CryptoKit, CommonCrypto, Security) und wird mit dem System aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cryptography comes from macOS itself (CryptoKit, CommonCrypto, Security) and is updated with the system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La criptografía proviene del propio macOS (CryptoKit, CommonCrypto, Security) y se actualiza con el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cryptographie provient de macOS lui-même (CryptoKit, CommonCrypto, Security) et est mise à jour avec le système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号処理は macOS 自体（CryptoKit、CommonCrypto、Security）によるもので、システムと一緒にアップデートされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호화는 macOS 자체(CryptoKit, CommonCrypto, Security)에서 제공되며 시스템과 함께 업데이트됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A criptografia vem do próprio macOS (CryptoKit, CommonCrypto, Security) e é atualizada com o sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Криптография берется из самой macOS (CryptoKit, CommonCrypto, Security) и обновляется вместе с системой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密功能由 macOS 自身提供（CryptoKit、CommonCrypto、Security），并随系统更新。"
          }
