    "The device's shell answered instead of SFTP: “%@”. Give this user a bash shell (Check Point: set user <name> shell /bin/bash), or use SCP." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statt SFTP hat die Shell des Geräts geantwortet: „%@“. Geben Sie diesem Benutzer eine Bash-Shell (Check Point: set user <name> shell /bin/bash) oder verwenden Sie SCP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respondió el shell del dispositivo en lugar de SFTP: “%@”. Asigne a este usuario un shell bash (Check Point: set user <name> shell /bin/bash) o use SCP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le shell de l’appareil a répondu à la place de SFTP : « %@ ». Donnez à cet utilisateur un shell bash (Check Point : set user <name> shell /bin/bash) ou utilisez SCP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFTP ではなくデバイスのシェルが応答しました:「%@」。このユーザーのシェルを bash にする（Check Point: set user <name> shell /bin/bash）か、SCP を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SFTP 대신 장비의 셸이 응답했습니다: “%@”. 이 사용자에게 bash 셸을 지정하거나(Check Point: set user <name> shell /bin/bash) SCP를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O shell do dispositivo respondeu em vez do SFTP: “%@”. Dê a este usuário um shell bash (Check Point: set user <name> shell /bin/bash) ou use SCP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вместо SFTP ответила оболочка устройства: «%@». Назначьте пользователю оболочку bash (Check Point: set user <name> shell /bin/bash) или используйте SCP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应答的是设备的 shell 而不是 SFTP：“%@”。请为该用户设置 bash shell（Check Point：set user <name> shell /bin/bash），或改用 SCP。"
          }
        }
      }
    },
