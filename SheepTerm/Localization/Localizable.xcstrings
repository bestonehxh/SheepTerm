    "Sends “%@” once the shell is up, so long output is not paged. Shown in the session and the log like anything else typed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet „%@“, sobald die Shell bereit ist, damit lange Ausgaben nicht seitenweise angezeigt werden. Erscheint in der Sitzung und im Protokoll wie jede andere Eingabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía “%@” en cuanto el shell está listo, para que la salida larga no se pagine. Se muestra en la sesión y en el registro como cualquier otra cosa que escribas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie « %@ » une fois le shell prêt, pour que les longues sorties ne soient pas paginées. Affiché dans la session et le journal comme toute autre saisie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルが起動したら「%@」を送信し、長い出力がページ分割されないようにします。入力したほかの内容と同様に、セッションとログに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸이 준비되면 “%@”을(를) 보내므로 긴 출력이 페이지로 나뉘지 않습니다. 직접 입력한 내용과 마찬가지로 세션과 로그에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia “%@” assim que o shell estiver pronto, para que saídas longas não sejam paginadas. Aparece na sessão e no registro como qualquer outra coisa digitada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет «%@», когда оболочка готова, чтобы длинный вывод не разбивался на страницы. Отображается в сессии и журнале, как любой введенный текст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "shell 就绪后发送“%@”，使长输出不分页。它会像其他输入内容一样显示在会话和日志中。"
          }
        }
      }
    },
