    "This host connects via a jump host that no longer exists (or is itself behind a jump host — one hop only). Edit the host and pick another, or None." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Host verbindet sich über einen Jump-Host, der nicht mehr existiert (oder selbst hinter einem Jump-Host liegt – nur ein Hop möglich). Bearbeiten Sie den Host und wählen Sie einen anderen oder „Ohne“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host se conecta a través de un host de salto que ya no existe (o que está a su vez detrás de otro host de salto; solo se permite un salto). Edita el host y elige otro, o Ninguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet hôte se connecte via un hôte de rebond qui n’existe plus (ou qui est lui-même derrière un hôte de rebond — un seul saut possible). Modifiez l’hôte et choisissez-en un autre, ou Aucun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストは、存在しない踏み台ホスト（またはそれ自体が踏み台ホストの背後にあるホスト — 踏み台は 1 段のみ）を経由して接続します。ホストを編集して、ほかのホストか「なし」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트는 더 이상 존재하지 않는 점프 호스트를 통해 연결합니다(또는 그 점프 호스트 자체가 다른 점프 호스트 뒤에 있음 — 한 단계만 가능). 호스트를 편집하여 다른 호스트나 없음을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este host se conecta por um host de salto que não existe mais (ou que está ele próprio atrás de um host de salto — apenas um salto). Edite o host e escolha outro, ou Nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот хост подключается через промежуточный хост, которого больше нет (или который сам находится за промежуточным хостом — допускается только один переход). Измените хост и выберите другой или «Нет»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机通过一台已不存在的跳板机连接（或该跳板机本身也在跳板机之后——仅支持一跳）。请编辑主机并选择另一台，或选择“无”。"
          }
        }
      }
    },
