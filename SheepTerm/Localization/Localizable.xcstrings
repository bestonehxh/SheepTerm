    "At least %lld characters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少需要 %lld 个字符。"
          }
        }
      }
    },
    "At least %lld characters. The link opens nothing without it. Tell the recipients by another route (phone, LINE) — never together with the link." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少需要 %lld 个字符。没有它，链接无法打开任何内容。请通过其他方式（电话、LINE）告知接收者——切勿与链接一起发送。"
          }
        }
      }
    },
