    "Logs into this host first and tunnels the connection through it (ProxyJump). Type user@host[:port] or pick a saved host; empty = direct. The jump host needs TCP forwarding allowed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs into this host first and tunnels the connection through it (ProxyJump). Type user@host[:port] or pick a saved host; empty = direct. The jump host needs TCP forwarding allowed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先登录此主机并通过它建立连接隧道（ProxyJump）。输入 user@host[:port] 或选择已保存的主机；留空 = 直接连接。跳板机需要允许 TCP 转发。"
          }
        }
      }
    },
