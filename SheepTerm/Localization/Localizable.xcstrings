    "%@ cannot be read. SheepTerm refuses every host key until it can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht gelesen werden. SheepTerm lehnt jeden Hostschlüssel ab, bis dies möglich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede leer %@. SheepTerm rechaza todas las claves de host hasta que pueda leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire %@. SheepTerm refuse toutes les clés d’hôte tant qu’il ne peut pas le lire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を読み込めません。読み込めるようになるまで、SheepTerm はすべてのホスト鍵を拒否します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 읽을 수 없습니다. 읽을 수 있을 때까지 SheepTerm은 모든 호스트 키를 거부합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler %@. O SheepTerm recusa todas as chaves de host até conseguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается прочитать %@. SheepTerm отклоняет все ключи хостов, пока файл не станет доступен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。在能够读取之前，SheepTerm 会拒绝所有主机密钥。"
          }
        }
      }
    },
    "%@ could not be read (%@) and could not be set aside. SheepTerm started with an empty list and will not overwrite the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konnte nicht gelesen werden (%@) und konnte nicht beiseitegelegt werden. SheepTerm wurde mit einer leeren Liste gestartet und überschreibt die Datei nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer %@ (%@) ni apartarlo. SheepTerm se inició con una lista vacía y no sobrescribirá el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire %@ (%@) ni de le mettre de côté. SheepTerm a démarré avec une liste vide et n’écrasera pas le fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を読み込めず（%@）、退避することもできませんでした。SheepTerm は空のリストで起動し、このファイルを上書きしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 읽을 수 없고(%@) 옆으로 옮겨 둘 수도 없습니다. SheepTerm은 빈 목록으로 시작했으며 파일을 덮어쓰지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler %@ (%@) nem colocá-lo de lado. O SheepTerm iniciou com uma lista vazia e não substituirá o arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать %@ (%@) и не удалось переместить его в сторону. SheepTerm запущен с пустым списком и не будет перезаписывать файл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@），也无法将其另存。SheepTerm 已以空白列表启动，不会覆盖该文件。"
          }
        }
      }
    },
    "%@ could not be read (%@). The credential list starts empty and the file will not be overwritten until you change something." : {
