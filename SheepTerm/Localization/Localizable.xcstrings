    "Every session log in %@. Double-click a line to open the log; the newest logs come first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Sitzungsprotokoll in %@. Doppelklicken Sie auf eine Zeile, um das Protokoll zu öffnen; die neuesten Protokolle stehen oben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los registros de sesión de %@. Haz doble clic en una línea para abrir el registro; los registros más recientes aparecen primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les journaux de session de %@. Double-cliquez sur une ligne pour ouvrir le journal ; les plus récents apparaissent en premier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 内のすべてのセッションログです。行をダブルクリックするとログが開きます。新しいログから順に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 있는 모든 세션 로그입니다. 줄을 이중 클릭하면 로그가 열리며, 최신 로그가 먼저 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os registros de sessão em %@. Clique duas vezes em uma linha para abrir o registro; os registros mais recentes aparecem primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все журналы сессий в %@. Дважды нажмите строку, чтобы открыть журнал; новые журналы показаны первыми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中的所有会话日志。双击某一行以打开日志；最新的日志排在前面。"
          }
        }
      }
    },
