{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "%@ %@ and could not be moved aside (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@，且无法移到一旁（%3$@）。"
          }
        }
      }
    },
    "%@ %@ is available" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 现已推出"
          }
        }
      }
    },
    "%@ %@ is the latest version." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 是最新版本。"
          }
        }
      }
    },
    "%@ (%@)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$@）"
          }
        }
      }
    },
    "%@ ago" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@前"
          }
        }
      }
    },
    "%@ can only replace itself when it runs from the Applications folder and that folder is writable. The verified %@ is in Finder: unzip it and move %@.app into Applications." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有从可写入的“应用程序”文件夹运行时，%1$@ 才能替换自身。已验证的 %2$@ 已在访达中显示：请解压并将 %3$@.app 移到“应用程序”文件夹。"
          }
        }
      }
    },
    "%@ cannot be read. SheepTerm refuses every host key until it can." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@。在能够读取之前，SheepTerm 会拒绝所有主机密钥。"
          }
        }
      }
    },
    "%@ could not be read (%@) and could not be set aside. SheepTerm started with an empty list and will not overwrite the file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@），也无法将其另存。SheepTerm 已以空白列表启动，不会覆盖该文件。"
          }
        }
      }
    },
    "%@ could not be read (%@)." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@）。"
          }
        }
      }
    },
    "%@ could not be read (%@). The credential list starts empty and the file will not be overwritten until you change something." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@）。凭据列表将以空白开始，在您做出更改之前不会覆盖该文件。"
          }
        }
      }
    },
    "%@ could not be read (%@). The snippet list starts empty and the file will not be overwritten until you change something." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@）。代码片段列表将以空白开始，在您做出更改之前不会覆盖该文件。"
          }
        }
      }
    },
    "%@ could not be read (%@); it was preserved as %@ and the list starts empty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %1$@（%2$@）；已保留为 %3$@，列表将以空白开始。"
          }
        }
      }
    },
    "%@ couldn't start — Settings ▸ AI" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法启动——设置 ▸ AI"
