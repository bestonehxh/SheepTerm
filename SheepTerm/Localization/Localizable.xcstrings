    "Cookies, logins and caches of every web tab are removed. Open pages may sign you out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, Anmeldungen und Caches aller Web-Tabs werden entfernt. Geöffnete Seiten melden Sie möglicherweise ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, logins and caches of every web tab are removed. Open pages may sign you out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan las cookies, inicios de sesión y cachés de todas las pestañas web. Es posible que las páginas abiertas cierren tu sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cookies, identifiants et caches de tous les onglets web sont supprimés. Les pages ouvertes peuvent vous déconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての Web タブの Cookie、ログイン情報、キャッシュが削除されます。開いているページからサインアウトされる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 웹 탭의 쿠키, 로그인 및 캐시가 제거됩니다. 열려 있는 페이지에서 로그아웃될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cookies, logins e caches de todas as abas web são removidos. As páginas abertas podem encerrar a sua sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы cookie, логины и кэш всех веб-вкладок будут удалены. На открытых страницах может быть выполнен выход."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除所有网页标签页的 Cookie、登录信息和缓存。已打开的页面可能会让您退出登录。"
          }
        }
      }
    },
