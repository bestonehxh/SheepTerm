        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépassait %lld Mo et n’a pas pu être mis de côté (%@). L’historique des commandes est vide et le fichier ne sera pas écrasé tant que vous n’effacez pas l’historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は %lld MB を超えており、退避もできませんでした（%@）。コマンド履歴は空の状態で始まり、履歴を消去するまでファイルは上書きされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) %lld MB보다 크고 옆으로 옮길 수 없습니다(%@). 명령 기록은 비어 있는 상태로 시작하며 기록을 지울 때까지 파일을 덮어쓰지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ era maior que %lld MB e não pôde ser movido para outro lugar (%@). O histórico de comandos começa vazio e o arquivo não será substituído até que você limpe o histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ был больше %lld MB, и его не удалось переместить в сторону (%@). История команд пуста, и файл не будет перезаписан, пока Вы не очистите историю."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 大于 %2$lld MB，且无法移到一旁（%3$@）。命令历史记录将以空白开始，在您清除历史记录之前不会覆盖该文件。"
          }
        }
      }
    },
