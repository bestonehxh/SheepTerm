      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在通过其他方式发送密码短语——电话、LINE、当面——切勿与链接放在同一条消息中。同时拥有两者的人都能打开共享。"
          }
        }
      }
    },
